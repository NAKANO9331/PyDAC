#include <iostream>
#include <vector>
#include <cmath>
#include "ReconTensor.h"

namespace dacpp {
    typedef std::vector<std::any> list;
}

// Grid parameters
const int NX = {{ nx }};
const int NY = {{ ny }};
const double Lx = {{ lx }};
const double Ly = {{ ly }};
const double alpha = {{ alpha }};
const int TIME_STEPS = {{ time_steps }};

// Spatial step size
const double dx = Lx / (NX - 1);
const double dy = Ly / (NY - 1);

// Stability condition
const double dt_stability = (dx * dx * dy * dy) / (2.0 * alpha * (dx * dx + dy * dy));
const double delta_t = 0.4 * dt_stability;

shell dacpp::list stencilShell(const dacpp::Matrix<double>& matIn, 
                                dacpp::Matrix<double>& matOut) {
    dacpp::split sp1(3, 1), sp2(3, 1);
    dacpp::index idx1, idx2;
    binding(sp1, idx1);
    binding(sp2, idx2);
    dacpp::list dataList{matIn[sp1][sp2], matOut[idx1][idx2]};
    return dataList;
}

calc void stencil(dacpp::Matrix<double>& mat, 
                    double* out) {
    out[0] = mat[1][1] + alpha * delta_t * (
        ((mat[2][1] - 2.0 * mat[1][1] + mat[0][1]) / (dx * dx)) + 
        ((mat[1][2] - 2.0 * mat[1][1] + mat[1][0]) / (dy * dy))
    );
}

int main() {
    // Initialize temperature field
    std::vector<double> u_curr(NX * NY, 0.0);
    std::vector<double> u_next(NX * NY, 0.0);

    // Initial condition: Gaussian distribution
    int cx = NX / 2;
    int cy = NY / 2;
    double sigma = 1.0;
    for(int i = 0; i < NX; ++i) {
        for(int j = 0; j < NY; ++j) {
            double x = i * dx;
            double y = j * dy;
            u_curr[i * NY + j] = std::exp(-((x - Lx/2.0)*(x - Lx/2.0) + (y - Ly/2.0)*(y - Ly/2.0)) / (2.0 * sigma * sigma));
        }
    }

    dacpp::Matrix<double> u_curr_tensor({NX, NY}, u_curr);
    dacpp::Matrix<double> u_next_tensor({NX, NY}, u_next);

    for(int i = 0; i < TIME_STEPS; i++) {
        dacpp::Matrix<double> middle_tensor = u_next_tensor[{1, NX-1}][{1, NY-1}];
        stencilShell(u_curr_tensor, middle_tensor) <-> stencil;

        for (int i = 1; i <= NX-2; i++) {
            for(int j = 1; j <= NY-2; j++){
                u_curr_tensor[i][j] = middle_tensor[i-1][j-1];
            }
        }

        // Boundary conditions
        for (int j = 0; j < NY; ++j) {
            u_curr_tensor[0][j] = u_curr_tensor[1][j];
            u_curr_tensor[NX - 1][j] = u_curr_tensor[NX-2][j];
        }
        for (int i = 0; i < NX; ++i) {
            u_curr_tensor[i][0] = u_curr_tensor[i][1];
            u_curr_tensor[i][NY-1] = u_curr_tensor[i][NY-2];
        }
    }

    return 0;
}

